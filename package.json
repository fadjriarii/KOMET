{
  "name": "komet",
  "version": "1.0.0",
  "private": true,
  "description": "KPI Observation, Monitoring and Evaluation Tool",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write \"**/*.{js,jsx,cjs,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,cjs,mjs,json,md}\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadjriarii/KOMET.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/fadjriarii/KOMET/issues"
  },
  "homepage": "https://github.com/fadjriarii/KOMET#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
