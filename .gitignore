# KOMET Monorepo — Single Root .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/

# Environment Variables & Secrets
.env
.env.*
*.env
*.env.*
*.local
!.env.example
!*.env.example

# Build & Output
dist/
dist-ssr/
build/
out/
.next/
*.tsbuildinfo

# Cache
.turbo/
.vite/
.cache/
.eslintcache
.stylelintcache
vite.config.*.timestamp-*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
.vitest/
coverage/
*.lcov
.nyc_output/

# Database & Prisma
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
**/generated/prisma

# Temporary / Scratch
scratch/
tmp/
temp/
*.tmp
*.bak
*.orig

# OS Files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db

# IDE & Editors
.idea/
.vscode/
*.swp
*.swo
*~

# AI / Agent & Workflow Tooling
# Local tool state only. Project skills that must be shared belong in
# .claude/skills/ or .opencode/skills/; see docs/SKILLS.md.
.agents/
.codex/
.kilo/
.ai/
.aider*
aider/
.qoder/
CLAUDE.local.md
.claude/settings.local.json

# Local source material
# requirements/ contains real SEVIMA credentials and student PII. Never unignore as-is.
requirements/

# Historical analysis and generated graph output
ai-context/
graphify-out/

# Local credentials and orchestration scratch
.aws/
komet-orchestrator/

# Keep curated documentation; ignore local research and vendor snapshots.
docs/*
!docs/ENGINEERING.md
!docs/SKILLS.md
!docs/adr/
!docs/adr/**

# Package manager: pnpm only
package-lock.json
yarn.lock
npm-shrinkwrap.json
