# KOMET Monorepo — Single Root .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.*
*.env
*.env.*
*.local
!.env.example
!*.env.example

# Build & Output 
dist/
dist-ssr/
build/
out/
.next/

# Cache
.turbo/
.vite/
.cache/
.eslintcache
.stylelintcache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
.vitest/
coverage/
*.lcov
.nyc_output/

# Database & Prisma
*.sqlite
*.sqlite3
*.db
*.db-journal
**/generated/prisma

# Temporary / Scratch & Test Dumps
scratch/
tmp/
temp/
test-*.js
test_*.js
test.json
*.tmp

# OS Files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db

# IDE & Editors
.idea/
.vscode/
*.swp
*.swo
*~

# AI / Agent & Workflow Tooling
.agents/
.codex/
.kilo/
ai-context/
.aider*
aider/
.qoder/
CLAUDE.local.md
.claude/settings.local.json

