# KOMET Backend - Environment Configuration Example
# Salin ke .env lalu isi nilainya. .env di-gitignore, jangan pernah commit.

# === Server Configuration ===
PORT=3000
NODE_ENV=development # Set ke 'production' saat deploy

# === Database (wajib) ===
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DB_NAME"

# === SEVIMA API (wajib, dipakai route sync) ===
SEVIMA_APP_KEY="your-app-key-here"
SEVIMA_SECRET_KEY="your-secret-key-here"

# === Security (wajib) ===
# Kunci endpoint /api/sync/* (ETL). Bukan pengganti sesi siswa.
SYNC_API_KEY="your-secure-random-api-key-here"
# Tanda tangan cookie sesi. Terpisah dari SYNC_API_KEY dengan sengaja.
SESSION_SECRET="another-long-random-secret-for-http-only-sessions"

# === Opsional, punya default di config/envValidator.js ===
SLOW_QUERY_MS=500
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3001"
# Jumlah hop reverse proxy yang dipercaya untuk req.ip (rate limit).
# false = deploy langsung/lokal. Contoh: 1 untuk satu load balancer.
TRUST_PROXY=false
# Level log winston: error | warn | success | info | debug
# Default bila dikosongkan: debug di development, info di production.
LOG_LEVEL=debug

# === Redis (opsional di lokal, wajib untuk >1 worker) ===
# Tanpa Redis, sesi dan rate limit hidup di memori proses ini saja: di PM2 cluster
# worker B tidak mengenali sesi worker A (401 acak) dan kuota limit terbagi per worker.
# REDIS_URL="redis://127.0.0.1:6379"
# Nyatakan degradasi ke store in-process secara sadar. Production tanpa REDIS_URL
# menolak start kecuali ini true. Aman hanya untuk single instance.
ALLOW_MEMORY_STORES=false

# === Diagnostik dev saja ===
# true menyertakan field error mentah di respons. Ditolak Zod bila NODE_ENV=production.
EXPOSE_ERROR_DETAILS=false
