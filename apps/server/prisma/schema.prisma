generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Student {
  nim             String           @id
  nama            String
  jenjang         String
  periodeMasuk    String
  /// Periode terakhir mahasiswa (keluar/lulus), kosong untuk mahasiswa yang masih berjalan.
  periodeTerakhir String           @default("")
  angkatan        String
  /// Periode semester masuk: "Ganjil" (kode berakhir 1) atau "Genap" (kode berakhir 2)
  periode         String           @default("")
  programStudi    String
  fakultas        String
  statusKeaktifan String
  semester        Int
  kewarganegaraan String
  nik             String           @default("")
  tanggalLahir    String           @default("")
  updatedAt       DateTime         @updatedAt
  
  // Relasi
  graduate        Graduate?
  mbkmActivities  MbkmActivity[]

  @@index([nik])
  @@index([statusKeaktifan])
  @@index([semester])
  @@index([fakultas])
  @@index([programStudi])
  @@index([jenjang])
  @@index([angkatan])
  @@index([periode])
  @@index([periodeMasuk])
  @@index([periodeTerakhir])
  @@index([kewarganegaraan])
  @@index([periodeMasuk, kewarganegaraan])
  @@index([statusKeaktifan, semester])
  @@index([statusKeaktifan, kewarganegaraan])
  @@index([statusKeaktifan, fakultas, programStudi])
  @@index([statusKeaktifan, angkatan])
  @@index([statusKeaktifan, periodeMasuk])
  @@map("students")
}

model Graduate {
  id              Int      @id @default(autoincrement())
  nim             String   @unique
  jenjang         String
  statusKelulusan String
  predikatLulus   String   @default("")
  tahunLulus      String
  periodeWisuda   String   @default("")
  ipk             Float
  sksLulus        Int
  
  // Relasi ke Student
  student         Student  @relation(fields: [nim], references: [nim], onDelete: Cascade)

  @@index([tahunLulus])
  @@index([jenjang])
  @@index([tahunLulus, jenjang])
  @@index([statusKelulusan])
  @@index([periodeWisuda])
  @@index([tahunLulus, statusKelulusan])
  @@map("graduates")
}

model MbkmActivity {
  id              Int      @id @default(autoincrement())
  nim             String
  periode         String
  programStudi    String
  fakultas        String
  jenjang         String
  statusKeaktifan String   @db.Text
  jenisAktivitas  String   @db.Text
  judulAktivitas  String   @db.Text
  mitra           String   @db.Text
  statusAktivitas String
  
  // Relasi ke Student
  student         Student  @relation(fields: [nim], references: [nim], onDelete: Cascade)

  @@index([periode])
  @@index([statusAktivitas])
  @@index([jenisAktivitas(length: 100)])
  @@index([periode, statusAktivitas])
  @@index([fakultas])
  @@index([programStudi])
  @@index([mitra(length: 100)])
  @@index([periode, fakultas])
  @@index([periode, programStudi])
  @@map("mbkm_activities")
}

/// Riwayat job sinkronisasi. Hanya n run terbaru yang disimpan (dipangkas
/// `services/sync/syncRunLog`), jadi tabel ini tetap kecil tanpa perlu paginasi.
model SyncRun {
  id         Int       @id @default(autoincrement())
  finishedAt DateTime
  /// 'manual' | 'automatic' — nilai; label tampilannya hidup di client.
  trigger    String    @db.VarChar(9)
  /// Kredensial yang memicu job ('Dashboard' | 'API Key'). Belum ada login user,
  /// jadi isinya jenis kredensial — dan selalu ditulis server, bukan klien.
  actor      String    @db.VarChar(32)
  /// 'completed' | 'failed' hasil job. Bisa berbeda dari hasil modul: job boleh
  /// gagal di tahap setelah semua modul selesai (mis. deduplikasi).
  status     String    @db.VarChar(9)
  /// [{ key, status }] untuk tiap modul yang dicakup job; status modul dinormalisasi
  /// menjadi 'completed' atau 'failed' saat ditulis.
  modules    Json
  /// Pesan kegagalan yang sudah lewat allowlist errorCatalog; null bila sukses.
  error      String?   @db.Text

  @@map("sync_runs")
}
