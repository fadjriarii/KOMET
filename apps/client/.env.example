# KOMET Frontend - Environment Configuration Example
# Salin ke .env lalu isi nilainya.

# Variabel yang dibaca kode frontend.
# `/api` = same origin (Vite dev proxy, or the server serving the built client).
# Absolute http(s) URL hanya untuk deploy frontend dan backend di origin berbeda.
VITE_API_BASE_URL=/api

# Penerima laporan error dari layar kegagalan (modules/errors/errorStates.js).
# Tautan mailto: — pesan dikirim dari klien surel pengguna (Gmail/Outlook), jadi
# tidak ada layanan pihak ketiga (SendGrid/Twilio) yang perlu dipasang.
VITE_SUPPORT_EMAIL=qa.intern@i3l.ac.id

# Jangan menaruh rahasia apa pun di file ini. Semua VITE_* dibakar ke bundle JS saat
# build dan bisa dibaca siapa pun lewat DevTools. Kunci server (SESSION_SECRET,
# SYNC_API_KEY, kredensial SEVIMA) hanya boleh ada di apps/server/.env; browser
# memperoleh akses lewat cookie sesi HttpOnly yang diterbitkan /api/session/student.
