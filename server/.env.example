# === Server Configuration ===
PORT=3000
NODE_ENV=development   # Set ke 'production' saat deploy

# === Database ===
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DB_NAME"

# === SEVIMA API ===
SEVIMA_APP_KEY="your-app-key-here"
SEVIMA_SECRET_KEY="your-secret-key-here"

# === Security ===
SYNC_API_KEY="your-secure-random-api-key-here"
SESSION_SECRET="another-long-random-secret-for-http-only-sessions"
SLOW_QUERY_MS=500
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3001"
# Set this only when the app is deployed behind a known reverse proxy. Examples:
# TRUST_PROXY=1          # one trusted proxy (typical load balancer setup)
# TRUST_PROXY=false      # direct/local deployment (default)
TRUST_PROXY=false
# Optional locally; required when running multiple server workers. The rate
# limiter and revocable student sessions use this shared Redis instance so
# counters and logout/revocation state cannot diverge per PID.
# REDIS_URL="redis://127.0.0.1:6379"
